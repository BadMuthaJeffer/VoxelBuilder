package com.voxelbuilder.client.render;

import com.mojang.blaze3d.vertex.PoseStack;
import com.voxelbuilder.client.build.BuildPlan;

import net.minecraft.client.Camera;
import net.minecraft.client.Minecraft;
import net.minecraft.client.renderer.LevelRenderer;
import net.minecraft.client.renderer.MultiBufferSource;
import net.minecraft.client.renderer.RenderType;
import net.minecraft.core.BlockPos;
import net.minecraft.world.phys.AABB;
import net.minecraft.world.phys.Vec3;

import java.util.List;

/**
 * Ghost preview renderer (debug wireframe).
 *
 * Render-only:
 * - Does NOT mutate world
 * - Does NOT mutate build plan
 *
 * Rotation + anchor are render-time only.
 */
public final class GhostPreviewDebugRenderer {

    /* =========================
     * Preview state
     * ========================= */

    private static BuildPlan previewPlan = null;

    private static boolean placementArmed = false;
    private static boolean anchorLocked = false;
    private static BlockPos anchorPos = null;

    /* =========================
     * Rotation (degrees, 90-step)
     * ========================= */

    private static int rotX = 0;
    private static int rotY = 0;
    private static int rotZ = 0;

    /* =========================
     * Bounds cache
     * ========================= */

    private static boolean boundsValid = false;
    private static int minX, minY, minZ;
    private static int maxX, maxY, maxZ;
    private static double pivotX, pivotY, pivotZ;

    private GhostPreviewDebugRenderer() {}

    /* =========================
     * Preview control
     * ========================= */

    public static void setPreview(BuildPlan plan) {
        previewPlan = plan;
        recacheBounds();
    }

    public static BuildPlan getPreview() {
        return previewPlan;
    }

    /* =========================
     * Placement lifecycle
     * ========================= */

    public static void armPlacement() {
        placementArmed = true;
        anchorLocked = false;
        anchorPos = null;
    }

    public static boolean isPlacementArmed() {
        return placementArmed;
    }

    public static boolean isAnchorLocked() {
        return anchorLocked;
    }

    public static BlockPos getAnchorPos() {
        return anchorPos;
    }

    public static void setAnchor(BlockPos pos) {
        if (!placementArmed || pos == null) return;
        anchorPos = pos;
        anchorLocked = true;
    }

    /** ✅ OPTION A FIX: used by hotkeys */
    public static void unlockAnchor() {
        anchorLocked = false;
    }

    public static void clearPlacement() {
        placementArmed = false;
        anchorLocked = false;
        anchorPos = null;
    }

    /* =========================
     * Rotation API
     * ========================= */

    public static void setPreviewRotationX(int deg) { rotX = norm90(deg); }
    public static void setPreviewRotationY(int deg) { rotY = norm90(deg); }
    public static void setPreviewRotationZ(int deg) { rotZ = norm90(deg); }

    public static int getPreviewRotationX() { return rotX; }
    public static int getPreviewRotationY() { return rotY; }
    public static int getPreviewRotationZ() { return rotZ; }

    public static void resetPreviewRotation() {
        rotX = 0;
        rotY = 0;
        rotZ = 0;
    }

    private static int norm90(int d) {
        d %= 360;
        if (d < 0) d += 360;
        return ((d + 45) / 90) * 90 % 360;
    }

    /* =========================
     * Rendering
     * ========================= */

    public static void render(PoseStack poseStack) {
        if (previewPlan == null) return;
        if (!anchorLocked || anchorPos == null) return;

        Minecraft mc = Minecraft.getInstance();
        if (mc == null || mc.level == null) return;

        if (!boundsValid) recacheBounds();
        if (!boundsValid) return;

        Camera cam = mc.gameRenderer.getMainCamera();
        Vec3 camPos = cam.getPosition();

        MultiBufferSource.BufferSource buffers = mc.renderBuffers().bufferSource();

        poseStack.pushPose();
        poseStack.translate(-camPos.x, -camPos.y, -camPos.z);

        List<BuildPlan.BlockPos3> blocks = previewPlan.getBlocks();

        for (BuildPlan.BlockPos3 p : blocks) {

            double x = p.x - minX - pivotX;
            double y = p.y - minY - pivotY;
            double z = p.z - minZ - pivotZ;

            // X rotation
            for (int i = 0; i < rotX / 90; i++) {
                double ty = y;
                y = -z;
                z = ty;
            }

            // Y rotation
            for (int i = 0; i < rotY / 90; i++) {
                double tx = x;
                x = z;
                z = -tx;
            }

            // Z rotation
            for (int i = 0; i < rotZ / 90; i++) {
                double tx = x;
                x = -y;
                y = tx;
            }

            x += pivotX;
            y += pivotY;
            z += pivotZ;

            int wx = anchorPos.getX() + (int)Math.round(x);
            int wy = anchorPos.getY() + (int)Math.round(y);
            int wz = anchorPos.getZ() + (int)Math.round(z);

            AABB box = new AABB(wx, wy, wz, wx + 1, wy + 1, wz + 1);

            LevelRenderer.renderLineBox(
                    poseStack,
                    buffers.getBuffer(RenderType.lines()),
                    box,
                    0.0f, 1.0f, 1.0f, 0.8f
            );
        }

        poseStack.popPose();
        buffers.endBatch();
    }

    /* =========================
     * Bounds
     * ========================= */

    private static void recacheBounds() {
        boundsValid = false;

        if (previewPlan == null) return;
        List<BuildPlan.BlockPos3> blocks = previewPlan.getBlocks();
        if (blocks == null || blocks.isEmpty()) return;

        minX = minY = minZ = Integer.MAX_VALUE;
        maxX = maxY = maxZ = Integer.MIN_VALUE;

        for (BuildPlan.BlockPos3 p : blocks) {
            minX = Math.min(minX, p.x);
            minY = Math.min(minY, p.y);
            minZ = Math.min(minZ, p.z);
            maxX = Math.max(maxX, p.x);
            maxY = Math.max(maxY, p.y);
            maxZ = Math.max(maxZ, p.z);
        }

        pivotX = ((maxX - minX) + 1) / 2.0;
        pivotY = ((maxY - minY) + 1) / 2.0;
        pivotZ = ((maxZ - minZ) + 1) / 2.0;

        boundsValid = true;
    }
}
