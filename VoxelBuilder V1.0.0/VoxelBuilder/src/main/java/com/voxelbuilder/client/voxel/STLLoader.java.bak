package com.voxelbuilder.client.voxel;

import java.io.File;
import java.io.FileInputStream;
import java.util.Collections;
import java.util.List;

/**
 * Unified STL loader with safety guards.
 *
 * Step N5:
 * - Detect ASCII vs Binary STL
 * - Hard-cap triangle count
 * - Fail safely instead of silently
 */
public final class STLLoader {

    /** Absolute safety cap — voxelisation cost explodes past this */
    private static final int MAX_TRIANGLES = 100_000;

    private STLLoader() {}

    public static List<STLAsciiLoader.Triangle> load(File file) {
        try {
            if (isBinarySTL(file)) {
                System.err.println("[VoxelBuilder] Binary STL detected: " + file.getName());
                // Binary support will be added later (N6)
                return Collections.emptyList();
            }

            List<STLAsciiLoader.Triangle> tris = STLAsciiLoader.load(file);

            if (tris.isEmpty()) {
                System.err.println("[VoxelBuilder] STL contains no triangles: " + file.getName());
                return Collections.emptyList();
            }

            if (tris.size() > MAX_TRIANGLES) {
                System.err.println(
                        "[VoxelBuilder] STL too dense (" + tris.size() +
                        " tris). Capping to " + MAX_TRIANGLES
                );
                return tris.subList(0, MAX_TRIANGLES);
            }

            return tris;

        } catch (Exception e) {
            System.err.println("[VoxelBuilder] Failed to load STL: " + file.getName());
            e.printStackTrace();
            return Collections.emptyList();
        }
    }

    /**
     * Very fast binary STL detection.
     * Binary STL:
     * - 80-byte header
     * - uint32 triangle count
     */
    private static boolean isBinarySTL(File file) {
        try (FileInputStream in = new FileInputStream(file)) {
            byte[] header = new byte[80];
            if (in.read(header) != 80) return false;

            byte[] countBytes = new byte[4];
            if (in.read(countBytes) != 4) return false;

            long triCount =
                    (countBytes[0] & 0xFF) |
                    ((countBytes[1] & 0xFF) << 8) |
                    ((countBytes[2] & 0xFF) << 16) |
                    ((countBytes[3] & 0xFF) << 24);

            long expectedSize = 84L + (triCount * 50L);
            return expectedSize == file.length();

        } catch (Exception ignored) {
            return false;
        }
    }
}
